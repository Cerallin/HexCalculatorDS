#!/bin/sh
# Git pre-commit hook: format staged C/C++ files, trim trailing spaces, and ensure final newline

# Get list of staged text files
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cc|cpp|h|hh|hpp|md|sh|txt|py|js|ts|json|yml|yaml|cmake)$')

if [ -z "$FILES" ]; then
    exit 0
fi

FORMATTED_FILES=""

for file in $FILES; do
    if [ -f "$file" ]; then
        original_hash=$(git hash-object "$file")
        # Format C/C++ files
        case "$file" in
            *.c|*.cc|*.cpp|*.h|*.hh|*.hpp)
                clang-format -i "$file"
                ;;
        esac
        # Trim trailing spaces and ensure final newline
        tmpfile=$(mktemp)
        # Remove trailing spaces
        sed -e 's/[ \t]*$//' "$file" > "$tmpfile"
        # Ensure final newline
        tail -c1 "$tmpfile" | read -r _ || echo >> "$tmpfile"
        mv "$tmpfile" "$file"
        updated_hash=$(git hash-object "$file")
        if [ "$original_hash" != "$updated_hash" ]; then
            FORMATTED_FILES="$FORMATTED_FILES $file"
            git add "$file"
        fi
    fi
done

if [ -n "$FORMATTED_FILES" ]; then
    echo ""
    echo "Formatting hook updated and re-staged the following files:"
    for formatted in $FORMATTED_FILES; do
        echo "  - $formatted"
    done
    echo ""
fi

exit 0
