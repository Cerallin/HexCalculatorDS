{
    "build": {
        "dockerfile": "./Dockerfile"
    },
    "remoteUser": "ubuntu",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.hexeditor",
                "streetsidesoftware.code-spell-checker",
                "yzhang.markdown-all-in-one",
                "eamodio.gitlens",
                "FanaticPythoner.better-todo-tree",
                "cschlosser.doxdocgen",
                "ms-python.autopep8",
                "ms-python.python"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.gitconfig,target=/home/ubuntu/.gitconfig,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/.devcontainer/cmake-tools-kits.json,target=/home/ubuntu/.local/share/CMakeTools/cmake-tools-kits.json,type=bind"
    ]
}
