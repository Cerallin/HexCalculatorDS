# Prefer CMake compile_commands (--compile-commands-dir in .vscode/settings.json).
# Strip GCC-only flags that Clang rejects.
# Do NOT add --target=... here: query-driver passes CompileFlags to g++,
# and arm-none-eabi-g++ does not accept Clang's -target.
#
# clangd 11 warns on CompileFlags.CompilationDatabase; use CLI flag instead.
CompileFlags:
  Remove:
    - -mthumb-interwork
